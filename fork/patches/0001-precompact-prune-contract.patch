index 000000000..e64121cd5
--- /dev/null
+++ b/packages/agent-core-v2/src/features/externalHooks/internal/hookMessages.ts
@@ -0,0 +1,58 @@
+import type { ContextMessage } from '#/agent/contextMemory/types';
+
+export const HOOK_MESSAGE_TEXT_CAP = 200_000;
+
+export interface HookToolCallRef {
+  readonly id: string;
+  readonly name: string;
+  readonly arguments: string;
+}
+
+export interface HookMessage {
+  readonly index: number;
+  readonly role: 'system' | 'user' | 'assistant' | 'tool';
+  readonly origin_kind?: string;
+  readonly text: string;
+  readonly tool_calls?: readonly HookToolCallRef[];
+  readonly tool_call_id?: string;
+  readonly is_error: boolean;
+  readonly chars: number;
+}
+
+export function toHookMessages(history: readonly ContextMessage[]): HookMessage[] {
+  return history.map((message, index) => toHookMessage(message, index));
+}
+
+function toHookMessage(message: ContextMessage, index: number): HookMessage {
+  const text = capHookText(
+    message.content
+      .filter((part) => part.type === 'text')
+      .map((part) => part.text)
+      .join(''),
+  );
+  const toolCalls =
+    message.role === 'assistant' && message.toolCalls.length > 0
+      ? message.toolCalls.map((call) => ({
+          id: call.id,
+          name: call.name,
+          arguments: call.arguments ?? '',
+        }))
+      : undefined;
+  const toolCallId = message.role === 'tool' ? message.toolCallId : undefined;
+  return {
+    index,
+    role: message.role,
+    origin_kind: message.origin?.kind,
+    text,
+    tool_calls: toolCalls,
+    tool_call_id: toolCallId,
+    is_error: message.isError === true,
+    chars: text.length,
+  };
+}
+
+function capHookText(text: string): string {
+  if (text.length <= HOOK_MESSAGE_TEXT_CAP) return text;
+  const omitted = text.length - HOOK_MESSAGE_TEXT_CAP;
+  return `${text.slice(0, HOOK_MESSAGE_TEXT_CAP)}[… ${String(omitted)} chars omitted …]`;
+}
diff --git a/packages/agent-core-v2/src/features/externalHooks/internal/pruneDecision.ts b/packages/agent-core-v2/src/features/externalHooks/internal/pruneDecision.ts
new file mode 100644
index 000000000..0637628cc
--- /dev/null
+++ b/packages/agent-core-v2/src/features/externalHooks/internal/pruneDecision.ts
@@ -0,0 +1,57 @@
+import type { HookMessage } from './hookMessages';
+import type { RawPruneDecision, ValidatedPruneDecision } from './types';
+
+export type PruneDecisionValidation =
+  | { readonly ok: true; readonly decision: ValidatedPruneDecision }
+  | { readonly ok: false; readonly reason: string };
+
+export function validatePruneDecision(
+  raw: RawPruneDecision,
+  messages: readonly HookMessage[],
+): PruneDecisionValidation {
+  const callIds = new Set<string>();
+  const resultIds = new Set<string>();
+  for (const message of messages) {
+    for (const call of message.tool_calls ?? []) {
+      callIds.add(call.id);
+    }
+    if (message.tool_call_id !== undefined) {
+      resultIds.add(message.tool_call_id);
+    }
+  }
+
+  const seen = new Set<string>();
+  for (const id of raw.dropCalls) {
+    const rejection = rejectId(id, callIds, resultIds, seen);
+    if (rejection !== undefined) return { ok: false, reason: rejection };
+    seen.add(id);
+  }
+
+  const truncateResults: { readonly toolCallId: string; readonly headChars: number }[] = [];
+  for (const truncate of raw.truncateResults) {
+    if (!Number.isInteger(truncate.headChars) || truncate.headChars < 0) {
+      return { ok: false, reason: `bad headChars for id "${truncate.toolCallId}"` };
+    }
+    const rejection = rejectId(truncate.toolCallId, callIds, resultIds, seen);
+    if (rejection !== undefined) return { ok: false, reason: rejection };
+    seen.add(truncate.toolCallId);
+    truncateResults.push({ toolCallId: truncate.toolCallId, headChars: truncate.headChars });
+  }
+
+  return {
+    ok: true,
+    decision: { dropCalls: [...raw.dropCalls], truncateResults, note: raw.note },
+  };
+}
+
+function rejectId(
+  id: string,
+  callIds: ReadonlySet<string>,
+  resultIds: ReadonlySet<string>,
+  seen: ReadonlySet<string>,
+): string | undefined {
+  if (seen.has(id)) return `duplicate id "${id}"`;
+  if (!callIds.has(id)) return `unknown tool call id "${id}"`;
+  if (!resultIds.has(id)) return `open tool exchange for id "${id}"`;
+  return undefined;
+}
